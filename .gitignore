# 파이썬
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# 사용자 작업물 — 저장소에 올리지 않는다
projects/
# 프로젝트 폴더에 잠깐 놓아 둔 음성·영상 파일이 실수로 공개되는 것을 막는다.
# (실제로 목소리 견본 mp3 7개가 저장소 맨 위에 올라간 적이 있다)
/*.mp3
/*.wav
/*.mp4
# 위 세 줄은 맨 위 칸의 파일만 막는다. 폴더에 담아 두면 그대로 통과하므로
# 들어보기·검토용으로 만든 폴더는 따로 막는다. (2026-08-14: 견본 14개가 걸렸다)
목소리_들어보기/
화면효과_데모*/
tests/sample/*.mp4
tests/sample/*.wav
tests/sample/*.mp3
# 샘플 나레이션 음성은 tools/make_sample.py 로 각자 만든다 (용량 절약)
tests/sample/narration/
# 점검용 사진은 tools/make_sample_images.py 로 각자 만든다 (30장 · 크기와 형식이 제각각)
tests/sample/images/

# 자막 번인용 폰트는 용량이 커서(1.5MB×2) tools/fetch_font.py 로 각자 받게 한다
assets/fonts/*.otf
assets/fonts/*.ttf
# 화면용 폰트(app/static/fonts/*.woff2)는 일부러 저장소에 포함한다.
# 이게 없으면 내려받은 사람의 화면이 윈도우 기본 글꼴로 나와 글자가 어수선해진다.
# Pretendard는 OFL 라이선스라 재배포가 허용된다.

# 설치 파일 빌드 결과물 (수백 MB — GitHub Releases로 배포한다)
build/

# 개발 도구
.vscode/
.idea/
.DS_Store
Thumbs.db

# Vercel 배포 캐시
landing/.vercel/
