# 파이썬
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# 사용자 작업물 — 저장소에 올리지 않는다
projects/
tests/sample/*.mp4
tests/sample/*.wav
tests/sample/*.mp3
# 샘플 나레이션 음성은 tools/make_sample.py 로 각자 만든다 (용량 절약)
tests/sample/narration/

# 자막 번인용 폰트는 용량이 커서(1.5MB×2) tools/fetch_font.py 로 각자 받게 한다
assets/fonts/*.otf
assets/fonts/*.ttf
# 화면용 폰트(app/static/fonts/*.woff2)는 일부러 저장소에 포함한다.
# 이게 없으면 내려받은 사람의 화면이 윈도우 기본 글꼴로 나와 글자가 어수선해진다.
# Pretendard는 OFL 라이선스라 재배포가 허용된다.

# 개발 도구
.vscode/
.idea/
.DS_Store
Thumbs.db

# Vercel 배포 캐시
landing/.vercel/
